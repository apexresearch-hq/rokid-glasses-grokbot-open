# Copy to .env on the hub / bridge host (never commit real secrets)

# Session bridge listen
HOST=127.0.0.1
PORT=8787
DATA_DIR=./session-bridge/data

# Protect /v1/* with Bearer token (required in any networked deploy)
BRIDGE_TOKEN=replace-with-long-random-string

# Delivery: gateway (default) | webhook | both
DELIVERY_MODE=gateway
GATEWAY_FALLBACK_MS=60000
GATEWAY_STALE_CLAIM_MS=120000

# Optional webhook fallback (Routine / inbound URL)
GROKBOT_WEBHOOK_URL=
GROKBOT_WEBHOOK_KEY=

# Plugin → bridge (usually same host loopback)
SESSION_BRIDGE_URL=http://127.0.0.1:8787

# Absolute base for signed /files and /reply links
PUBLIC_BASE_URL=https://glasses.example.com

# gateway-relay (developer machine) — set explicitly; no built-in production default
# DEFAULT_BOT_ID=00000000-0000-4000-8000-000000000001
# SMOKE_BOT_ID=00000000-0000-4000-8000-000000000001
# UPLOAD_MAX_BYTES=10485760
